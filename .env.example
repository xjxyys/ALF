# Copy to .env and fill in what you need: cp -n .env.example .env
# Every entry point in scripts/ reads this file; the library reads the same variables from the environment.

# A checkout of marin-community/marin at 8577d258214dd0dcb992c04458ee4eb10496d4e5, where the model, the train step
# and the recipe come from. Marin's own environment installs it, so this is needed only when it is not importable;
# then it is put on sys.path instead.
MARIN_REPO=../marin

# A local copy of marin-community/marin-tokenizer; tokenization runs offline from it.
MARIN_TOKENIZER_DIR=/path/to/marin-tokenizer

# Storage roots (default: ./data and ./output inside the repository; symlinks to larger disks are fine).
# DATA_ROOT=/path/to/data
# OUTPUT_ROOT=/path/to/output

# Training run directories, as <root>/<run name>/checkpoints/step-N (default: ${OUTPUT_ROOT}/runs).
# RUN_ROOT=/path/to/runs

# Bytecode and JAX compilation caches, kept out of the Marin checkout (default: ~/.cache/alf).
# ALF_CACHE_DIR=/path/to/cache

# Raw Dolma 3 HQ 300B shuffled parquet shards, the input of scripts/prepare_data.py.
# DOLMA_SRC=/path/to/dolma3_hq_300B_shuffled

# The same archive, still zipped: 11 tasks of the downstream bundle are copied out of it. Without this,
# alf.bench.prepare downloads it into --data-root once. Its SHA-256 is checked either way.
# CORE_ARCHIVE=/path/to/eval_bundle.zip

# The downstream bench bundle written by scripts/prepare_bench.py (manifest.json, suite.json, records/).
# BENCH_BUNDLE=/path/to/bench
