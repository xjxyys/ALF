  "upstream_defaults_not_read_here": {
    "comment": "carried from the upstream suite and not honoured by this scorer, which caps at min(max_seq_len, 4096), packs 8 rows per forward and never truncates",
    "dtype": "float32",
    "context_policy": "error",
    "model_max_length": 20480,
    "batch_size": 1,
    "wandb": false
  },
